PROJECT_IMPORT_PDF_MAX_PAGES=100
PROJECT_IMPORT_PDF_MAX_TEXT_BYTES=2097152
PROJECT_IMPORT_PDF_REJECT_ENCRYPTED=true
PROJECT_IMPORT_PROVIDER=n8n
PROJECT_IMPORT_SCHEMA_VERSION=project-import.v1
PROJECT_IMPORT_PROMPT_VERSION=
PROJECT_IMPORT_MODEL_NAME=
