PROJECT_IMPORT_N8N_CONNECT_TIMEOUT_SECONDS=5
PROJECT_IMPORT_CALLBACK_URL=
PROJECT_IMPORT_CALLBACK_SECRET=
PROJECT_IMPORT_CALLBACK_PREVIOUS_SECRET=
PROJECT_IMPORT_CALLBACK_MAX_CLOCK_SKEW_SECONDS=300
PROJECT_IMPORT_CALLBACK_MAX_BODY_BYTES=1048576
PROJECT_IMPORT_CALLBACK_MAX_REQUESTS_PER_MINUTE=60
DB_QUEUE_RETRY_AFTER=180
BEANSTALKD_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
